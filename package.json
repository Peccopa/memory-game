{
  "name": "js-starter-pack",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "prettier": "3.9.6",
    "validate-branch-name": "^1.3.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,html,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "validate-branch-name": {
    "pattern": "^(main|(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test|experiment)/([0-9]+-)?[a-z0-9-]+)$",
    "errorMsg": "Branch name must follow pattern: <type>/<issue-number>-<description> or <type>/<description>. Example: feat/add-login-form or feat/117-add-login-form"
  }
}
